<?xml version="1.0" encoding="UTF-8"?>
<ui version="4.0">
    <class>MainWindow</class>

    <!-- Clase main Inicio -->
    <widget class="QMainWindow" name="LangTags">

        <!-- Menu -->
        <widget class="QMenuBar" name="menubar">
            <widget class="QMenu" name="menu_setting"/>
            <addaction name="menu_setting"/>

            <widget class="QAction" name="action_update_database"/>
            <addaction name="action_update_database"/>
        </widget>


        <widget class="QStatusBar" name="statusbar"/>

        <!-- Widget central -->
        <widget class="QWidget" name="central_widget">

            <layout class="QVBoxLayout" name="vbox_main"> <!-- Para centrar todo -->

                <item>
                    <!-- Pestañas -->
                    <widget class="QTabWidget" name="tab_widget">
                        <property name="sizePolicy">
                            <sizepolicy hsizetype="Expanding" vsizetype="Preferred">
                                <horstretch>0</horstretch>
                                <verstretch>0</verstretch>
                            </sizepolicy>
                        </property>
                    </widget>
                </item>

            </layout> <!-- Para centrar todo -->

        </widget>
    </widget>

    <!-- Clase main cierre -->
    <resources/>
    <connections/>
</ui>
