<?xml version="1.0" encoding="UTF-8"?>
<ui version="4.0">
    <!-- Clase inicio -->
    <class>SettingForm</class>

    <widget class="QWidget" name="centralWidget">
        <layout class="QVBoxLayout" name="vbox_main">

            <!-- Formulario -->
            <item>
                <layout class="QGridLayout" name="form">

                    <item row="0" column="0">
                        <widget class="QLabel" name="label_current_language">
                            <property name="text"><string>current language</string></property>
                        </widget>
                    </item>
                    <item row="0" column="1">
                        <widget class="QComboBox" name="combobox_languages">
                        </widget>
                    </item>

                </layout>
            </item>


            <!-- Tabla -->
            <item>
                <widget class="QTableWidget" name="table">
                    <property name="wordWrap">
                        <bool>true</bool>
                    </property>
                </widget>
            </item>

        </layout>
    </widget>

    <!-- Clase cierre -->
    <resources/>
    <connections/>
</ui>
