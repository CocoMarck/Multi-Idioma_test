<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Views.MainWindow"
        Title="LangTags" Width="800" Height="600">
    <TabControl>
        <TabItem x:Name="LanguagesTab" Header="Languages"/>
        <TabItem x:Name="TagsTab" Header="Tags"/>
        <TabItem x:Name="TranslationsTab" Header="Translations"/>
        <TabItem x:Name="SettingsTab" Header="Settings"/>
        <TabItem x:Name="GetTextTab" Header="GetText"/>
    </TabControl>
</Window>
