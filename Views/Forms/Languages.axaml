<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Views.Forms.Languages">
    <DockPanel>
        <!-- Id data -->
        <StackPanel DockPanel.Dock="Top"
                    Orientation="Horizontal">
            <Label Content="Id"/>
            <TextBox/>
            <ComboBox/>
        </StackPanel>
        <!-- Tag data -->
        <StackPanel DockPanel.Dock="Top"
                    Orientation="Horizontal">
            <Label Content="Tag"/>
            <TextBox/>
            <ComboBox/>
        </StackPanel>
        <!-- Text data -->
        <StackPanel DockPanel.Dock="Top"
                    Orientation="Horizontal">
            <Label Content="Text"/>
            <TextBox/>
        </StackPanel>
        <!-- Buttons -->
        <StackPanel DockPanel.Dock="Top"
                    Orientation="Horizontal">
            <Button Content="Save"/>
            <Button Content="Refresh"/>
        </StackPanel>
        <!-- Table -->
        <ScrollViewer HorizontalScrollBarVisibility="Auto"
                      VerticalScrollBarVisibility="Auto">
            <!-- Grid donde se pintará la tabla -->
            <Grid x:Name="TableGrid" ShowGridLines="True">
            </Grid>
        </ScrollViewer>
    </DockPanel>
</UserControl>