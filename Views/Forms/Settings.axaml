<UserControl xmlns="https://github.com/avaloniaui"
            xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
            x:Class="Views.Forms.Settings">
    <DockPanel>
        <Grid DockPanel.Dock="Top"
              Margin="0,0,0,20"
              RowDefinitions="Auto"
              ColumnDefinitions="*,*">
              <Label x:Name="labelLanguage" Grid.Row="0" Grid.Column="0" Content="Language"/>
              <ComboBox x:Name="comboboxLanguages" Grid.Row="0" Grid.Column="1" HorizontalAlignment="Stretch" SelectedIndex="0"/>
        </Grid>
        <!-- Table -->
        <ScrollViewer HorizontalScrollBarVisibility="Auto"
                      VerticalScrollBarVisibility="Auto">
            <Grid x:Name="tableGrid" ShowGridLines="True">
            </Grid>
        </ScrollViewer>
    </DockPanel>
</UserControl>